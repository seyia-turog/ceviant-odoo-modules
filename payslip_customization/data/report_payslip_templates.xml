<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_payslip_inherit_multi_currency" inherit_id="hr_payroll_community.report_payslip">
        <span t-esc="line.amount" position="replace">
            <span t-esc="line.amount"  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
        </span>
        <span t-esc="line.total" position="replace">
            <span class="text-right" t-esc="line.total" t-options='{"widget": "monetary", "display_currency": o.currency_id, "text-align": "right"}'/>
        </span>
    </template>
</odoo>
