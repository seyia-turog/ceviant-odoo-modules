<odoo>
    <data>
        <template id="report_payslip_inherit_multi_currency" inherit_id="hr_payroll_community.report_payslip">
            <xpath expr="//td[span[@t-esc='line.amount']]" position="replace">
                <td>
                    <span t-esc="line.amount" t-options='{"widget": "monetary", "display_currency": o.contract_id.currency_id}'/>
                </td>
            </xpath>
            <xpath expr="//td[span[@t-esc='line.total']]" position="replace">
                <td class="text-right">
                    <span t-esc="line.total" t-options='{"widget": "monetary", "display_currency": o.contract_id.currency_id}'/>
                </td>
            </xpath>
        </template>
    </data>
</odoo>
